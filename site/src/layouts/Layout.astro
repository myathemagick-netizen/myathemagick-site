---
import PageNavigation from '../components/PageNavigation.astro';
import '../styles/interior.css';
import Nav from '../components/Nav.astro';
import '../styles/theme.css';
const { noindex = false, canonical, title = "Home", description = "A living system at the intersection of sacred geometry, chaos magick, torsion field physics, and the structure of time itself." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google Analytics: collect only on the live website. -->
    <script is:inline>
      if (['myathemagick.com', 'www.myathemagick.com'].includes(window.location.hostname)) {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-3G63808RC6');
        const googleTag = document.createElement('script');
        googleTag.async = true;
        googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=G-3G63808RC6';
        document.head.appendChild(googleTag);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} · Myathe Magick</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Crimson+Pro:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav />
    <main id="main-content" class:list={{'inner-page': Astro.url.pathname !== '/'}}>
    {Astro.url.pathname !== '/' && <PageNavigation title={title} />}
    <slot />
    </main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    background: #09090f;
    color: var(--text);
    font-family: 'Crimson Pro', Georgia, serif;
    min-height: 100vh;
  }
  a { color: inherit; text-decoration: none; }
</style>