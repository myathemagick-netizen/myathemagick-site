---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
const {title,description,canonical}=Astro.props;
---
<Layout title={title} description={description} canonical={canonical} noindex={true}><article class="studio-information"><div class="kicker">Personal desktop application / Information</div><slot/></article><Footer/></Layout>
<style is:global>
.studio-information{max-width:900px;margin:0 auto;padding:42px 5% 65px;font:18px/1.8 var(--sans);overflow-wrap:anywhere}.studio-information h1{font:700 clamp(34px,5vw,52px)/1.15 var(--display);color:var(--heading);margin:16px 0 24px}.studio-information h2{font:600 26px/1.3 var(--sans);color:var(--heading);margin:34px 0 14px}.studio-information p,.studio-information ul{margin:16px 0}.studio-information ul{padding-left:24px}.studio-information a{color:var(--mint);text-decoration:underline;text-underline-offset:3px}.studio-information a:focus-visible{outline:2px solid var(--mint);outline-offset:4px}.studio-information .studio-notice{border:1px solid var(--line);border-left:3px solid var(--mint);padding:20px;background:var(--panel);border-radius:6px}.studio-information .effective{font-size:14px;color:var(--muted)}.studio-information code{font-size:14px;overflow-wrap:anywhere}
</style>
