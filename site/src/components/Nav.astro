---
const links = [
  { href: "/system", label: "The System" },
  { href: "/system/atlas", label: "Atlas" },
  { href: "/tools", label: "Tools" },
  { href: "/writing", label: "Writing" },
  { href: "/watch", label: "Watch" },
  { href: "/music", label: "Music" },
  { href: "/game", label: "Game" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href) => href === "/system" ? currentPath === "/system" || (currentPath.startsWith("/system/") && !currentPath.startsWith("/system/atlas")) : currentPath === href || currentPath.startsWith(href + "/");
---

<nav>
  <a href="/" class="nav-logo">
    <svg viewBox="0 0 100 100" width="24" height="24">
      <defs>
        <linearGradient id="nhg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#c084fc"/>
          <stop offset="100%" stop-color="#6d28d9"/>
        </linearGradient>
      </defs>
      <rect width="100" height="100" rx="18" fill="#09090f"/>
      <polygon points="50,8 85,29 85,71 50,92 15,71 15,29" fill="url(#nhg)"/>
    </svg>
    <span>Myathe Magick</span>
  </a>

  <div class="nav-links">
    {links.map(link => (
      <a href={link.href} class={isActive(link.href) ? "active" : ""} aria-current={isActive(link.href) ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </div>

  <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-inner">
    {links.map(link => (
      <a href={link.href} class={`mobile-link ${isActive(link.href) ? "active" : ""}`} aria-current={isActive(link.href) ? "page" : undefined}>
        <span class="mobile-link-num">
          {String(links.indexOf(link) + 1).padStart(2, "0")}
        </span>
        {link.label}
      </a>
    ))}
    <div class="mobile-footer-links">
      <a href="https://youtube.com/channel/UClWbNxQMrx-XB3h8xXh_oxQ/" target="_blank">YouTube</a>
      <a href="https://myathemagick.substack.com/" target="_blank">Substack</a>
      <a href="https://ko-fi.com/myathemagick" target="_blank">Ko-fi</a>
      <a href="https://x.com/MyatheMagick" target="_blank">X</a>
    </div>
  </div>
</div>

<script is:inline>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.contains('open');
    mobileMenu.classList.toggle('open');
    hamburger.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    hamburger.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });

  document.addEventListener('keydown', (e) => { if(e.key === 'Escape' && mobileMenu.classList.contains('open')) { mobileMenu.classList.remove('open'); hamburger.classList.remove('open'); hamburger.setAttribute('aria-expanded','false'); hamburger.setAttribute('aria-label','Open menu'); hamburger.focus(); } });

  // Close menu when a link is clicked
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      hamburger.classList.remove('open');
      hamburger.setAttribute('aria-expanded', false);
    });
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!hamburger.contains(e.target) && !mobileMenu.contains(e.target)) {
      mobileMenu.classList.remove('open');
      hamburger.classList.remove('open');
      hamburger.setAttribute('aria-expanded', false);
    }
  });
</script>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    border-bottom: 1px solid rgba(139,92,246,0.1);
    position: sticky;
    top: 0;
    background: rgba(9,9,15,0.95);
    backdrop-filter: blur(8px);
    z-index: 200;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Cinzel', serif;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--lavender);
    text-decoration: none;
  }
  .nav-logo:hover { color: var(--lavender); }
  .nav-links {
    display: flex;
    gap: 28px;
  }
  .nav-links a {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--lavender); }

  /* HAMBURGER */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 300;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 1px;
    background: #6d5a8a;
    transition: all 0.25s ease;
    transform-origin: center;
  }
  .hamburger:hover span { background: #c4b5fd; }
  .hamburger.open span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* MOBILE MENU */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: 280px;
    height: 100vh;
    background: #0a0a14;
    border-left: 1px solid rgba(139,92,246,0.15);
    z-index: 150;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    visibility: hidden;
  }
  .mobile-menu.open {
    transform: translateX(0);
    visibility: visible;
  }
  .mobile-menu-inner {
    padding: 80px 32px 40px;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(139,92,246,0.06);
    text-decoration: none;
    color: var(--text);
    font-family: 'Cinzel', serif;
    font-size: 14px;
    letter-spacing: 0.15em;
    transition: color 0.15s;
  }
  .mobile-link:hover, .mobile-link.active { color: var(--lavender); }
  .mobile-link-num {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.2em;
    min-width: 24px;
  }
  .mobile-link.active .mobile-link-num { color: #7c3aed; }

  .mobile-footer-links {
    margin-top: auto;
    padding-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .mobile-footer-links a {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .mobile-footer-links a:hover { color: var(--muted); }

  @media (max-width: 1100px) {
    nav { padding: 14px 20px; }
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }
nav { background: rgba(20,12,25,.96); border-color: var(--line); padding: 22px 3%; }
.nav-logo { color: var(--heading); font: 700 clamp(16px,2vw,25px)/1.2 var(--display); letter-spacing: .16em; }
.nav-links { gap: 22px; }
.nav-links a { font: 15px/1.5 var(--sans); letter-spacing: .02em; padding: 8px 0; border-bottom: 2px solid transparent; }
.nav-links a.active { color: var(--mint); border-color: var(--mint); }
.nav-links a[href="/game"].active { color: var(--coral); border-color: var(--coral); }
.mobile-menu-inner { overflow-y: auto; padding-top: 95px; }
</style>