---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('atlas');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>

  <div class="page-header">
    <div class="eyebrow">Atlas · {entry.data.book}</div>
    <h1>{entry.data.title}</h1>
    <p class="intro">{entry.data.description}</p>
  </div>

  <div class="prose-wrap">
    <Content />
  </div>

  <div class="footer-nav">
    <a href="/system/atlas" class="back-link">← Atlas index</a>
  </div>

  <Footer />

</Layout>

<style>
  :global(body) { overflow-x: hidden; }

  .page-header {
    padding: 56px 40px 40px;
    border-bottom: 1px solid rgba(139,92,246,0.08);
    max-width: 760px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 0.5em;
    color: #4c3d6e;
    margin-bottom: 16px;
    font-family: 'Cinzel', serif;
    text-transform: uppercase;
  }
  h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 400;
    color: #f0ecff;
    margin-bottom: 16px;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  .intro {
    font-size: 14px;
    color: #4c3d6e;
    font-weight: 300;
    line-height: 1.8;
    max-width: 640px;
    font-style: italic;
  }

  .prose-wrap {
    padding: 48px 40px 56px;
    max-width: 760px;
  }

  /* Prose content styles */
  .prose-wrap :global(h1),
  .prose-wrap :global(h2),
  .prose-wrap :global(h3),
  .prose-wrap :global(h4) {
    font-family: 'Cinzel', serif;
    font-weight: 400;
    color: #c4b5fd;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin: 2.5em 0 0.8em;
  }
  .prose-wrap :global(h1) { font-size: clamp(1.2rem, 2vw, 1.6rem); color: #e2d9f3; }
  .prose-wrap :global(h2) { font-size: clamp(1rem, 1.8vw, 1.3rem); }
  .prose-wrap :global(h3) { font-size: 1rem; color: #9d8cd4; }
  .prose-wrap :global(h4) { font-size: 0.9rem; color: #7c6a99; letter-spacing: 0.08em; text-transform: uppercase; }

  .prose-wrap :global(p) {
    font-size: 15px;
    color: #7c6a99;
    line-height: 1.9;
    font-weight: 300;
    margin-bottom: 1.4em;
  }

  .prose-wrap :global(strong) { color: #c4b5fd; font-weight: 400; }
  .prose-wrap :global(em) { color: #9d8cd4; font-style: italic; }

  .prose-wrap :global(hr) {
    border: none;
    border-top: 1px solid rgba(139,92,246,0.12);
    margin: 2.5em 0;
  }

  .prose-wrap :global(ul),
  .prose-wrap :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.4em;
  }
  .prose-wrap :global(li) {
    font-size: 15px;
    color: #7c6a99;
    line-height: 1.8;
    font-weight: 300;
    margin-bottom: 0.4em;
  }

  .prose-wrap :global(blockquote) {
    border-left: 2px solid rgba(139,92,246,0.3);
    padding: 8px 20px;
    margin: 1.5em 0;
    background: rgba(109,40,217,0.04);
  }
  .prose-wrap :global(blockquote p) {
    color: #6d5a8a;
    font-style: italic;
    margin-bottom: 0;
  }

  .footer-nav {
    padding: 0 40px 48px;
    border-top: 1px solid rgba(139,92,246,0.06);
    padding-top: 32px;
  }
  .back-link {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: #4c3d6e;
    text-decoration: none;
    transition: color 0.15s;
  }
  .back-link:hover { color: #9d8cd4; }

  @media (max-width: 800px) {
    .page-header { padding: 40px 24px 32px; }
    .prose-wrap { padding: 32px 24px 40px; }
    .footer-nav { padding: 24px 24px 40px; }
  }
</style>
