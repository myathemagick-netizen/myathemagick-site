---
import Layout from '../layouts/Layout.astro';
const gameConcept = 'https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/mycelium-concept-interior.webp';
import Footer from '../components/Footer.astro';
import { topics } from '../data/game';
const previews = [
 ['foraging.jpg','Picking a wild mushroom beside a road','First discoveries','Find, forage, and begin recording what you learn.'],
 ['autumn-lot.jpg','Weathered building and overgrown pavement in autumn','Inherited places','Explore the traces of a world left behind.'],
 ['sporelands-night.jpg','Giant turquoise mushrooms glowing at night','Sporelands at night','A glimpse of the fungal world in the current build.'],
 ['electronics-crafting.jpg','Circuit-board salvage recipe at an Electronics Bench','Salvage & discovery','Study found objects and turn parts into useful materials.']
];
---
<Layout title="Mycelium · Game" description="A voxel survival game about what's left behind and what grows back. Follow its development and explore the field manual.">
<div class="game-wrap">
  <section class="game-hero">
    <div><div class="kicker">Game / Development</div><h1>What's left behind.<br />What grows back.</h1><img class="mycelium-logo" src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/mycelium-logo.png" alt="Mycelium" width="2079" height="756" fetchpriority="high" /><p class="game-lead">A voxel survival world of ruins, discovery, and fungal regrowth.</p><div class="game-actions"><a class="design-button primary" href="/game/getting-started">Read the field manual →</a><a class="design-button" href="/game/notebook">Development notebook →</a><a class="design-button" href="/game/items">Objects of Mycelium →</a></div></div>
    <div class="design-panel world-statement"><img class="game-concept" src={gameConcept} alt="Concept illustration of a reclaimed workshop in the ruins" width={1000} /><span class="concept-caption">Concept art · Visual direction</span><span class="kicker">Mycelium / In development</span><h2>Nature rebuilds differently.</h2><p>Inherit the ruins of abundance. Scavenge what remains, study what you find, and make a place in a world that keeps changing.</p><span class="status">● In development</span></div>
  </section>
  <div class="game-middle">
    <section class="design-panel release"><div class="kicker">Release station</div><h2>No public build listed</h2><p>Mycelium is in development. There is no public download available yet.</p><button disabled>Download game — not yet available</button></section>
    <section class="design-panel" id="field-notes"><div class="kicker">Field Notes / Field manual</div><h2>Inside the world</h2><p>Explore the game’s current loop and the ideas guiding its development.</p><div class="notes-table">{topics.map((topic,i) => <article class="note-row"><a class="preview" href={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${previews[i][0]}`} aria-label={`Enlarge: ${previews[i][1]}`}><img src={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${previews[i][0]}`} alt={previews[i][1]} loading="lazy" /></a><div><span class="kicker">Field note 0{i+1}</span><h3><a href={`/game/${topic.slug}`}>{topic.title} →</a></h3><p>{topic.description}</p><div class="caption"><strong>{previews[i][2]}</strong><span>{previews[i][3]}</span></div></div></article>)}</div><a class="design-button notebook-link" href="/game/notebook">Development Notebook · View screenshots →</a></section>
  </div>
  <p class="source-note">Based on the game design document and beginner’s guide. Design notes describe intentions and may change as development continues.</p>
</div><Footer />
</Layout>
<style>
.game-wrap { padding:40px 3%; }.game-hero { display:grid; grid-template-columns:1.3fr 1fr; gap:40px; align-items:stretch; margin-bottom:24px; }h1 { font:700 clamp(40px,4.7vw,72px)/1.06 var(--display); letter-spacing:-.035em; color:var(--heading); margin:18px 0; }.game-lead { font:23px/1.5 var(--sans); max-width:34ch; }.game-actions { display:flex; flex-wrap:wrap; gap:14px; margin-top:28px; }.world-statement { display:flex; flex-direction:column; justify-content:center; background:radial-gradient(ellipse at top right,#5c365775,transparent),var(--panel); border-color:var(--mint); min-height:340px; }.world-statement h2 { font-size:42px; max-width:12ch; }.world-statement p { max-width:36ch; }.status { color:var(--mint); font:12px monospace; margin-top:25px; text-transform:uppercase; letter-spacing:.15em; }.game-middle { display:grid; grid-template-columns:1fr 2fr; gap:18px; }h2 { font:700 28px/1.2 var(--display); color:var(--heading); margin:14px 0; }p { font:17px/1.7 var(--sans); }.release button { background:#ffffff0a; color:var(--muted); border:1px solid var(--line); padding:16px; margin-top:28px; width:100%; font:15px var(--sans); }.source-note { color:var(--muted); margin:22px 0; font-size:14px; }@media(max-width:850px) { .game-hero,.game-middle { grid-template-columns:1fr; }.world-statement { min-height:250px; } }
.notebook-grid {display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:25px}.notebook-grid a {border-top:1px solid var(--line);padding-top:20px}.notebook-grid a:hover h3 {color:var(--mint)}h3 {font:600 20px/1.4 var(--sans);color:var(--heading);margin:6px 0 10px}.notebook-link{margin-top:22px}@media(max-width:500px){.notebook-grid{grid-template-columns:1fr}}.notes-table{border:1px solid var(--line);border-radius:8px;overflow:hidden;margin:24px 0}.note-row{display:grid;grid-template-columns:180px minmax(0,1fr);gap:20px;padding:20px;border-bottom:1px solid var(--line);background:#160e1c40}.note-row:last-child{border-bottom:0}.preview{align-self:center}.preview img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:5px}.note-row h3{font-size:23px;margin:8px 0}.note-row h3 a{color:var(--heading)}.note-row h3 a:hover{color:var(--mint)}.note-row p{font-size:15px;margin:8px 0}.caption{border-left:2px solid var(--lavender);padding-left:12px;margin-top:12px;font:13px/1.5 var(--sans)}.caption strong,.caption span{display:block}.caption strong{color:var(--mint);font-weight:600}.caption span{color:var(--muted);margin-top:4px}.release{align-self:start}@media(max-width:1100px){.game-middle{grid-template-columns:1fr}.note-row{grid-template-columns:240px minmax(0,1fr)}}@media(max-width:600px){.note-row{grid-template-columns:1fr}.preview{max-width:300px}}
.game-wrap{position:relative;isolation:isolate}.game-wrap::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(90deg,rgba(16,10,22,.52),rgba(16,10,22,.12) 65%),linear-gradient(180deg,rgba(16,10,22,.12) 0%,rgba(16,10,22,.2) 45%,var(--bg,#160f1c) 95%),url('https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/rustbelt-dusk.png') center top / auto 1250px no-repeat;background-color:#160f1c}.game-hero>div:first-child{background:transparent;border:0;text-shadow:0 2px 16px #100a16}.game-middle>.design-panel,.world-statement{background-color:#211728}.world-statement{background-image:radial-gradient(ellipse at top right,#5c365775,transparent)}@media(max-width:850px){.game-wrap::before{background-size:auto,auto,auto 1000px;background-position:center top}}
.mycelium-logo{display:block;width:100%;max-width:600px;height:auto;margin:26px 0 22px;filter:drop-shadow(0 0 12px rgba(64,236,216,.38)) drop-shadow(0 0 32px rgba(64,236,216,.22))}@media(max-width:600px){.mycelium-logo{margin:20px 0}}</style>




