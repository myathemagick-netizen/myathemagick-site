---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import PreviewCards from '../../components/GamePreviewCards.astro';
import data from '../../data/game-preview.json';
import '../../styles/game-preview.css';
export function getStaticPaths(){return [...data.sections.map(section=>({params:{section:section.id},props:{section}})),...Object.entries({"getting-started":"systems","world-and-ruins":"atlas","mycelium-and-affinity":"future","crafting-and-discovery":"systems"}).map(([slug,target])=>({params:{section:slug},props:{redirect:target}}))];}
if(Astro.props.redirect) return Astro.redirect("/game/"+Astro.props.redirect,301);
const {section}=Astro.props;
---
<Layout title={section.title+' · Mycelium'} description={section.description}><div class="game-preview-wrap"><nav class="preview-nav" aria-label="Explore Mycelium"><a href="/game">Overview</a>{data.sections.map(s=><a href={`/game/${s.id}`} aria-current={s.id===section.id?'page':undefined}>{s.title}</a>)}</nav><header class="preview-heading"><span class="kicker">Mycelium: Aftergrowth / In development</span><h1>{section.title}</h1><p>{section.description}</p></header>
{section.id==='atlas'&&<><PreviewCards cards={data.zones}/><section class="preview-section"><h2>Places left behind</h2><PreviewCards cards={data.places}/>{data.mascots&&<figure class="mascot-preview"><img src={data.mascots.src} alt={data.mascots.alt} loading="lazy"/><figcaption>Flame, Droppy, Tiger, and Dilly · In-game billboard asset preview.</figcaption></figure>}</section><p class="preview-note">These are glimpses of the world, rather than a map of every discovery. Plains, woodland, wetlands, and rocky highlands also lie beyond these featured lands.</p></>}
{section.id==='field-guide'&&<><p class="preview-note">A small selection of finds and residents. No recipe lists or loot tables: some discoveries should happen in the world itself.</p><div class="item-tabs" role="tablist" aria-label="Item types">{data.groups.map((g,i)=><button id={`tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`items-${i}`} tabindex={i===0?0:-1}>{g.name}</button>)}</div>{data.groups.map((g,i)=><section id={`items-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i!==0}><h2>{g.name}</h2><PreviewCards cards={g.cards} icons={g.name!=='Wildlife'}/></section>)}</>}
{section.id==='systems'&&<><section class="core-loop"><h2>Find → Learn → Make → Settle</h2><p>Scavenging, discovery, crafting, and making a home feed back into one another. A forgotten object can give your next journey a direction.</p></section><PreviewCards cards={data.systems}/><p class="preview-note">These describe the current development build. Systems, art, and balance continue to change.</p></>}
{section.id==='future'&&<><aside class="preview-notice">These features are not playable. Planned work is intended; concepts are possibilities, not promises.</aside><PreviewCards cards={data.future}/></>}
{section.id==='development'&&<><p class="preview-note">Selected highlights from the October 11 development handoff. This is a visual summary, not the full technical journal.</p><PreviewCards cards={data.updates}/></>}
{section.id==='play'&&<><section class="support-preview"><h2>Not publicly playable yet</h2><p>Mycelium: Aftergrowth is in active development. A development preview exists for testing, but there is no verified public download to share here.</p><h2>Follow the growing world</h2><p>New looks at the lands, objects, and systems will appear in the Development Notebook as the game evolves.</p><a class="design-button" href="/game/development">Visit the Development Notebook →</a><h2>Support the creator</h2><p>You can visit Myathe Magick’s existing Ko-fi page. Game access, supporter tiers, release plans, and a feedback destination will be announced once confirmed.</p><a class="design-button" href="https://ko-fi.com/myathemagick" target="_blank" rel="noopener noreferrer">Visit Myathe Magick on Ko-fi ↗</a></section></>}
<a class="design-button preview-back" href="/game">← Back to Mycelium</a></div><Footer/></Layout>
<script>
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));const panels=Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));function select(i:number){tabs.forEach((t,n)=>{t.setAttribute('aria-selected',String(n===i));t.tabIndex=n===i?0:-1;panels[n].hidden=n!==i})}tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>select(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();select(next);tabs[next].focus()})});
</script>
