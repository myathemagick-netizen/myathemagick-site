---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { topics } from '../../data/game';
const previews = [
 ['foraging.jpg','Picking a wild mushroom beside a road','First discoveries','Find, forage, and begin recording what you learn.'],
 ['autumn-lot.jpg','Weathered building and overgrown pavement in autumn','Inherited places','Explore the traces of a world left behind.'],
 ['sporelands-night.jpg','Giant turquoise mushrooms glowing at night','Sporelands at night','A glimpse of the fungal world in the current build.'],
 ['electronics-crafting.jpg','Circuit-board salvage recipe at an Electronics Bench','Salvage & discovery','Study found objects and turn parts into useful materials.']
];
const extraCaptures = [
 ['rustbelt-interior.png','Lamp-lit industrial hall at night','Inside the Rust Belt','A broken roof, weathered metal, and a light in the ruins.'],
 ['garden.jpg','Player-built planters with vegetables and mushrooms','Making a place','Cultivation among the remains of the town.']
];
---
<Layout title="Development notebook · Mycelium" description="Current gameplay captures and field notes from the development of Mycelium.">
<div class="notebook-wrap"><a class="kicker" href="/game">Mycelium / Development</a><h1>Development notebook</h1><p class="lead">Explore the world taking shape: its ruins, fungal landscapes, and everyday discoveries.</p><p class="note">Current gameplay and development captures. Each field note expands on the ideas and systems shown here.</p><section aria-label="Field notes" class="notes-table">{topics.map((topic,i) => <article class="note-row"><a class="preview" href={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${previews[i][0]}`} aria-label={`Enlarge: ${previews[i][1]}`}><img src={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${previews[i][0]}`} alt={previews[i][1]} loading="lazy" /></a><div><span class="kicker">Field note 0{i+1}</span><h2><a href={`/game/${topic.slug}`}>{topic.title} →</a></h2><p>{topic.description}</p><div class="caption"><strong>{previews[i][2]}</strong><span>{previews[i][3]}</span></div></div></article>)}</section><section class="additional"><h2>More from the current build</h2><div class="additional-grid">{extraCaptures.map(([file,alt,title,caption]) => <figure><a href={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${file}`} aria-label={`Enlarge: ${alt}`}><img src={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${file}`} alt={alt} loading="lazy" /></a><figcaption><strong>{title}</strong><span>{caption}</span></figcaption></figure>)}</div></section><div class="actions"><a class="design-button" href="/game/items">Explore the objects of Mycelium →</a><a class="design-button" href="/game">← Back to Mycelium</a></div><p class="note">Select any screenshot to enlarge. Design notes describe intentions and may change as development continues.</p></div><Footer />
</Layout>
<style>
.notebook-wrap{max-width:1100px;margin:auto;padding:40px 4% 60px}h1{font:700 clamp(36px,5vw,60px)/1.1 var(--display);color:var(--heading);margin:20px 0;text-shadow:0 0 25px #ca9cdf25}.lead{font:21px/1.6 var(--sans);max-width:65ch}.note{font:14px/1.7 var(--sans);color:var(--muted)}.notes-table{border:1px solid var(--line);border-radius:8px;overflow:hidden;margin:30px 0}.note-row{display:grid;grid-template-columns:260px minmax(0,1fr);gap:26px;padding:24px;background:var(--panel);border-bottom:1px solid var(--line)}.note-row:last-child{border-bottom:0}.preview{align-self:center}img{display:block;width:100%;height:auto;border-radius:5px;border:1px solid var(--line)}h2{font:600 27px/1.3 var(--sans);color:var(--heading);margin:8px 0 12px}h2 a{color:inherit}h2 a:hover{color:var(--mint)}p{font:16px/1.7 var(--sans);margin:10px 0}.caption{border-left:2px solid var(--lavender);padding-left:13px;margin-top:16px;font:14px/1.5 var(--sans)}strong,figcaption span,.caption span{display:block}strong{color:var(--mint);font-weight:600}.caption span,figcaption span{color:var(--muted);margin-top:4px}.additional-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:780px}figure{margin:10px 0 24px}figcaption{font:14px/1.6 var(--sans);margin-top:12px}.actions{display:flex;flex-wrap:wrap;gap:14px;margin:24px 0}@media(max-width:650px){.note-row{grid-template-columns:1fr;gap:16px}.preview{max-width:360px}.additional-grid{grid-template-columns:1fr;max-width:360px}}
</style>