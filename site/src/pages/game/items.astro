---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---
<Layout title="Objects of Mycelium · Game" description="Explore isometric previews of the objects, workstations, and discoveries in Mycelium.">
<main class="objects-wrap"><a class="kicker" href="/game">Game / Development</a><h1>Objects of Mycelium</h1><p class="lead">Familiar things. Unexpected discoveries. A world assembled from the objects people leave behind and the things you might make next.</p><p class="note">Isometric game asset previews. These show models in development; their uses and availability may change. Select an image to view the original.</p><div class="objects-grid"><article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/dinosaur_skeleton.png" aria-label="Enlarge Dinosaur skeleton"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/dinosaur_skeleton.png" alt="Isometric game model: Dinosaur skeleton" width="192" height="192" loading="lazy" /></a><span class="kicker">Traces of the past</span><h3>Dinosaur skeleton</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/flatscreen_tv.png" aria-label="Enlarge Flatscreen TV"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/flatscreen_tv.png" alt="Isometric game model: Flatscreen TV" width="192" height="192" loading="lazy" /></a><span class="kicker">Traces of the past</span><h3>Flatscreen TV</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/bookshelf.png" aria-label="Enlarge Bookshelf"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/bookshelf.png" alt="Isometric game model: Bookshelf" width="192" height="192" loading="lazy" /></a><span class="kicker">Traces of the past</span><h3>Bookshelf</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/electronics_bench.png" aria-label="Enlarge Electronics bench"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/electronics_bench.png" alt="Isometric game model: Electronics bench" width="192" height="192" loading="lazy" /></a><span class="kicker">Work & discovery</span><h3>Electronics bench</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/alembic.png" aria-label="Enlarge Alembic"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/alembic.png" alt="Isometric game model: Alembic" width="192" height="192" loading="lazy" /></a><span class="kicker">Work & discovery</span><h3>Alembic</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/culture_bench.png" aria-label="Enlarge Culture bench"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/culture_bench.png" alt="Isometric game model: Culture bench" width="192" height="192" loading="lazy" /></a><span class="kicker">Work & discovery</span><h3>Culture bench</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/easel.png" aria-label="Enlarge Easel"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/easel.png" alt="Isometric game model: Easel" width="192" height="192" loading="lazy" /></a><span class="kicker">Making a place</span><h3>Easel</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/electric_lamp.png" aria-label="Enlarge Electric lamp"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/electric_lamp.png" alt="Isometric game model: Electric lamp" width="192" height="192" loading="lazy" /></a><span class="kicker">Making a place</span><h3>Electric lamp</h3></article>
<article class="object-card"><a href="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/crop_mush_teal.png" aria-label="Enlarge Teal mushroom crop"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/crop_mush_teal.png" alt="Isometric game model: Teal mushroom crop" width="192" height="192" loading="lazy" /></a><span class="kicker">Making a place</span><h3>Teal mushroom crop</h3></article></div><div class="object-actions"><a class="design-button" href="/game/world-and-ruins">Explore the world & ruins →</a><a class="design-button" href="/game/crafting-and-discovery">Crafting & discovery →</a><a class="design-button" href="/game">← Back to Mycelium</a></div></main><Footer />
</Layout>
<style>
.objects-wrap{max-width:1200px;margin:auto;padding:40px 4% 60px}h1{font:700 clamp(38px,5vw,64px)/1.1 var(--display);color:var(--heading);margin:20px 0;text-shadow:0 0 24px #c998df25}.lead{font:21px/1.7 var(--sans);max-width:65ch}.note{font:14px/1.7 var(--sans);color:var(--muted);max-width:80ch}.objects-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:30px 0}.object-card{border:1px solid var(--line);border-radius:8px;padding:24px;background:radial-gradient(ellipse at center top,#70528b30,transparent 70%),var(--panel)}.object-card a{display:flex;justify-content:center;min-height:210px;align-items:center}.object-card img{width:192px;height:192px;image-rendering:pixelated;object-fit:contain;transition:transform .2s}.object-card a:hover img{transform:translateY(-5px)}h3{font:600 23px/1.4 var(--sans);color:var(--heading);margin:10px 0}.object-actions{display:flex;gap:14px;flex-wrap:wrap}@media(max-width:800px){.objects-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.objects-grid{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.object-card img{transition:none}}
</style>