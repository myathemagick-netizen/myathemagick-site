---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { topics } from '../../data/game';
export function getStaticPaths() { return topics.map(topic => ({params:{slug:topic.slug},props:{topic}})); }
const { topic } = Astro.props;
const sectionCaptures: Record<string, [string, string, string][][]> = {
 'getting-started': [
  [['foraging.jpg','Picking a wild mushroom beside a town road','Current gameplay · Your first discoveries begin with what you find.']],
  [],
  [['knowledge.jpg','Knowledge screen showing cultivation, mycology, and electronics discoveries','Current gameplay · Recording knowledge and discovering connections.']]
 ],
 'crafting-and-discovery': [
  [['electronics-crafting.jpg','Electronics Bench interface showing a circuit-board salvage recipe','Current gameplay · Salvaging a circuit board into useful parts.']],
  [['garden.jpg','Player-built planters with vegetables and mushrooms among the ruins','Current gameplay · Cultivating a place of your own.']],
  []
 ],
 'world-and-ruins': [
  [['autumn-lot.jpg','An abandoned lot in autumn','Weathered buildings and reclaimed ground.'], ['rustbelt-interior.png','A lamp-lit Rust Belt hall at night','Current gameplay · Inside the industrial ruins.']],
  [['works-office.png','Isometric preview of a weathered works office','Building preview · Works office.'], ['rail-yard.png','Rail yard with boxcars and rusted tracks','Building preview · Rail yard.']],
  [['catwalk.png','Vines hanging beneath an industrial catwalk','Current gameplay · Vegetation returning to the works.']]
 ],
 'mycelium-and-affinity': [
  [['sporelands-night.jpg','Giant glowing mushrooms in the Sporelands at night','Current gameplay · Sporelands at night.']], [], []
 ]
};
const captures = sectionCaptures[topic.slug] ?? [];
const position = topics.findIndex(t => t.slug === topic.slug);
const previous = topics[position-1];
const next = topics[position+1];
---
<Layout title={topic.title + ' · Mycelium'}>
<div class="manual-shell">
<aside class="design-panel"><a class="kicker" href="/game">Game / Field manual</a><nav aria-label="Game documentation">{topics.map(t => <a href={`/game/${t.slug}`} aria-current={topic.slug === t.slug ? 'page' : undefined}>{t.title}</a>)}</nav></aside>
<article class="design-panel"><div class="kicker">{topic.label}</div><h1>{topic.title}</h1><p class="lead">{topic.description}</p>{topic.sections.map(([title,text],i) => <section id={`section-${i}`}><h2>{title}</h2><p>{text}</p>{(captures[i] ?? []).map(([file,alt,caption]) => <figure><a href={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${file}`} aria-label={`Enlarge: ${alt}`}><img src={`https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/${file}`} alt={alt} loading="lazy" /></a><figcaption>{caption} Select the image to enlarge.</figcaption></figure>)}</section>)}<a class="design-button" href="/game/items">Explore game objects →</a><p class="note">Development notes based on the game design document and beginner’s guide. Features and systems may change.</p><nav class="manual-pagination" aria-label="Previous and next topics">{previous && <a class="design-button" href={`/game/${previous.slug}`}>← {previous.title}</a>}{next && <a class="design-button" href={`/game/${next.slug}`}>{next.title} →</a>}</nav><a class="design-button" href="/game">← Back to Mycelium</a></article>
<aside class="design-panel toc"><span class="kicker">On this page</span><nav aria-label="On this page">{topic.sections.map(([title],i) => <a href={`#section-${i}`}>{title}</a>)}</nav><span class="kicker">In development</span></aside>
</div><Footer />
</Layout>
<style>
.manual-shell { display:grid; grid-template-columns:220px minmax(0,1fr) 220px; gap:20px; padding:30px 3%; }.manual-shell aside { align-self:start; position:sticky; top:110px; padding:22px 16px; }nav { display:flex; flex-direction:column; margin:20px 0; }nav a { padding:14px 8px; font:16px/1.5 var(--sans); border-bottom:1px solid #765d7e60; }nav a[aria-current] { background:#ff827818; color:var(--coral); border-left:3px solid var(--coral); }h1 { font:700 clamp(34px,4vw,55px)/1.1 var(--display); color:var(--heading); letter-spacing:-.03em; margin:16px 0; }.lead { color:var(--lavender); font-size:23px; border-bottom:1px solid var(--line); padding-bottom:25px; }h2 { font:600 27px/1.3 var(--sans); color:var(--heading); margin:35px 0 12px; }p { font:19px/1.8 var(--sans); max-width:68ch; }.note { font-size:14px; color:var(--muted); margin:35px 0; }@media(max-width:1100px) { .manual-shell { grid-template-columns:200px minmax(0,1fr); }.toc { display:none; } }@media(max-width:700px) { .manual-shell { display:block; }.manual-shell aside { position:static; margin-bottom:20px; } }
figure{margin:22px 0}figure img{display:block;width:100%;height:auto;border-radius:6px;border:1px solid var(--line)}figcaption{font:14px/1.5 var(--sans);color:var(--lavender);margin-top:9px}
</style>