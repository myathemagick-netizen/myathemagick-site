---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Crystal from '../components/Crystal.astro';
import { crystalPath } from '../data/crystal-path';
const atlasHero = 'https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/atlas-connections-hero.png';
const rivvitPreview = 'https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/tool-rivvit.png';
const audioPreview = 'https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/tool-audio-shear-zone.png';
const ritesPreview = 'https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/tool-virtual-rites.png';
const gameConcept = 'https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/mycelium-concept-interior.webp';

---

<Layout title="Home">
  <section class="opening" aria-label="Myathe Magick and Mycelium">
    <div class="hero-left">
      <img class="opening-image" src={atlasHero} alt="" sizes="(max-width: 800px) 94vw, 52vw" loading="eager" fetchpriority="high" />
      <div class="opening-copy">
      <img class="hero-wordmark" src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/myathe-magick-wordmark.png" alt="Myathe Magick" width="2087" height="753" />
      <h1>Thirty years at the<br><em>edge of the map</em></h1>
      <p class="tagline">A living system at the intersection of sacred geometry, chaos magick, torsion field physics, and the structure of time itself.</p>
      <div class="cta-row">
        <a href="/system" class="btn-primary">Enter the System</a>
        <a href="/tools" class="btn-ghost">Explore the tools</a>
      </div></div>
      <span class="art-caption">Atlas / Illustrative artwork</span>
    </div>
    <article class="opening-game">
      <img class="opening-image" src={gameConcept} alt="Mycelium concept art: fungi reclaiming an industrial interior." width={1000} loading="eager" />
      <span class="development-badge">In development · Concept art</span>
      <div class="game-copy"><h2 class="mycelium-title"><img src="https://pub-eecb1a92d0fc4240bd6e42897daf01f6.r2.dev/site-refresh/mycelium-logo.png" alt="Mycelium" width="2079" height="756" /></h2><p>What's left behind. What grows back. A voxel survival game of ruins, scavenging, and fungal regrowth.</p><a class="design-button" href="/game">Follow development →</a></div>
    </article>
  </section>
  <section class="crystal-section" aria-labelledby="crystal-heading">
    <div class="crystal-row">
      <div class="crystal-label"><h2 id="crystal-heading">Crystal Path</h2><p>Seven principles.<br />One living system.</p></div>
      {crystalPath.map((element,index) => <div class="crystal-item" data-crystal={element.id}>
        <a href={`/system/${element.id}`} class="crystal-link" aria-describedby={`crystal-description-${element.id}`} data-crystal-select={element.id}><Crystal icon={element.icon} color={element.color} size={76} /><span>{element.name}</span></a>
        <button class="crystal-details" type="button" data-crystal-select={element.id} aria-controls="crystal-info" aria-pressed={index===0} aria-label={`Show information about ${element.name}`}>Details</button>
      </div>)}
    </div>
    <div class="crystal-info" id="crystal-info">
      {crystalPath.map((element,index) => <div class="crystal-info-content" data-crystal-panel={element.id} hidden={index!==0}>
        <div><h3>{element.name}</h3><p id={`crystal-description-${element.id}`}>{element.description}</p></div>
        <a class="design-button" href={`/system/${element.id}`}>Explore {element.name.split(' / ')[0]} →</a>
      </div>)}
    </div>
    <p class="crystal-hint">Hover or focus a crystal to read about it. Select Details on touch screens; select the crystal to open its page.</p>
  </section>
  <!-- TOOLS -->
  <section class="tools-section">
    <div class="tools-heading"><h2>Tools you can step into</h2><span class="kicker">Actual interface previews</span></div>
    <div class="tools-grid">
      <a href="https://myathemagick-netizen.github.io/audio-shear-zone/" target="_blank" rel="noopener noreferrer" class="tool-card">
        <img class="tool-preview" src={audioPreview} alt="Audio Shear Zone interface showing frequency presets and binaural controls." width={720} loading="lazy" />
        <div class="tool-copy"><div class="tool-icon">◉</div>
        <div class="tool-name">Audio Shear Zone</div>
        <div class="tool-desc">Binaural attunement engine. 25 Crystal Path presets, Solfeggio carriers, environmental soundscapes, and Live Earth Sync via NOAA space weather data.</div>
        <div class="tool-link">↗ Open tool</div></div>
      </a>
      <a href="https://myathemagick-netizen.github.io/RiVViT/" target="_blank" class="tool-card">
        <img class="tool-preview" src={rivvitPreview} alt="RiVViT interactive Earth globe with green network lines and vortex nodes." width={720} loading="lazy" />
        <div class="tool-copy"><div class="tool-icon">⬡</div>
        <div class="tool-name">RiVViT</div>
        <div class="tool-desc">An interactive VR globe mapping the icosahedral riftline network across the Earth's surface. Open in any browser or headset.</div>
        <div class="tool-link">↗ Open globe</div></div>
      </a>
      <a href="https://myathemagick-netizen.github.io/virtual-rites/" target="_blank" rel="noopener noreferrer" class="tool-card">
        <img class="tool-preview" src={ritesPreview} alt="Virtual Rites interface with ritual choices and Stonehenge beneath an aurora sky." width={720} loading="lazy" />
        <div class="tool-copy"><div class="tool-icon">✧</div><div class="tool-name">Virtual Rites</div><div class="tool-desc">Ritual spaces you can step into in a web browser or VR headset. Choose a rite, a place, and an intent, with voice guidance or at your own pace.</div><div class="tool-link">↗ Enter a ritual space</div></div>
      </a>
    </div>
    <a href="/tools" class="all-tools">Explore all instruments →</a>
  </section>


  <section class="feature-deck" aria-label="Explore Myathe Magick">
    <article class="design-panel"><span class="kicker">01 / The Atlas</span><h2>At the edge of the map</h2><p>A Pataphysical Atlas of Chronon Geography. Explore the Grid of Rifts and Vortices, from the introduction through six books.</p><a class="design-button" href="/system/atlas">Read the Atlas ↗</a></article>
    <article class="design-panel"><span class="kicker">02 / Writing & sound</span><h2>Other landscapes</h2><p>Essays, music, and ideas from the world of Myathe Magick.</p><div style="display:flex;gap:12px;flex-wrap:wrap"><a class="design-button" href="/writing">Read writing →</a><a class="design-button" href="/music">Listen →</a></div></article>
</section>

  <!-- STATS -->
  <section class="stats-bar" aria-label="Myathe Magick in numbers">
    <div class="stat stat-crystals">
      <div class="stat-crystal-art" aria-hidden="true">{crystalPath.map((element,i) => <span style={`--crystal-position: ${i - 3}`}><Crystal icon={element.icon} color={element.color} size={54} /></span>)}</div>
      <div class="stat-copy"><div class="stat-num">7</div><div class="stat-label">Crystal Path elements</div></div>
    </div>
    <div class="stat stat-network">
      <img class="stat-backdrop" src={rivvitPreview} alt="" width={600} loading="lazy" />
      <div class="stat-copy"><div class="stat-num">20</div><div class="stat-label">Icosahedral riftlines</div></div>
    </div>
    <div class="stat stat-time">
      <svg class="stat-line-art" viewBox="0 0 300 200" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor"><circle cx="190" cy="92" r="76"/><circle cx="190" cy="92" r="62"/><circle cx="190" cy="92" r="46"/><circle cx="190" cy="92" r="23"/><path d="M190 8V22M190 162V176M106 92H120M260 92H274M190 92L230 53M190 92L169 70M116 148L265 36"/><ellipse cx="190" cy="92" rx="90" ry="32" transform="rotate(-35 190 92)"/></g></svg>
      <div class="stat-copy"><div class="stat-num">30</div><div class="stat-label">Years of system-building</div></div>
    </div>
    <div class="stat stat-edge">
      <img class="stat-backdrop" src={atlasHero} alt="" width={600} loading="lazy" />
      <svg class="stat-line-art infinity-art" viewBox="0 0 300 200" aria-hidden="true" focusable="false"><path d="M150 100C105 30 42 35 42 100S105 170 150 100 258 30 258 100 195 170 150 100Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
      <div class="stat-copy"><div class="stat-num">∞</div><div class="stat-label">Dragons at the edge</div></div>
    </div>
  </section>

  <Footer />
</Layout>
<script>
  const section = document.querySelector('.crystal-section');
  const showCrystal = (id: string) => {
    section?.querySelectorAll<HTMLElement>('[data-crystal-panel]').forEach(panel => { panel.hidden = panel.dataset.crystalPanel !== id; });
    section?.querySelectorAll<HTMLButtonElement>('.crystal-details').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.crystalSelect === id)));
    section?.querySelectorAll<HTMLElement>('.crystal-item').forEach(item => item.classList.toggle('selected', item.dataset.crystal === id));
  };
  section?.querySelectorAll<HTMLElement>('[data-crystal-select]').forEach(control => {
    const show = () => showCrystal(control.dataset.crystalSelect!);
    control.addEventListener('mouseenter', show);
    control.addEventListener('focus', show);
    if (control.tagName === 'BUTTON') control.addEventListener('click', show);
  });
</script>
<style>
.opening { display:grid; grid-template-columns:minmax(0,1.12fr) minmax(0,1fr); gap:20px; padding:24px 3%; }
.hero-left,.opening-game { position:relative; isolation:isolate; overflow:hidden; min-height:480px; border:1px solid var(--line); border-radius:7px; }
.opening :global(.opening-image) { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
.hero-left :global(.opening-image) { object-position:65% center; }
.hero-left::before { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,rgba(20,12,25,.95),rgba(20,12,25,.75) 48%,rgba(20,12,25,.16)); }
.opening-copy { padding:36px; min-height:480px; display:flex; flex-direction:column; justify-content:center; align-items:flex-start; }
.eyebrow { font:12px/1.5 monospace; letter-spacing:.18em; color:var(--lavender); margin-bottom:20px; }
h1 { font:700 clamp(36px,4vw,60px)/1.06 var(--display); letter-spacing:-.04em; color:var(--heading); margin:0 0 22px; text-shadow:0 2px 12px #140c19; }
h1 em { font:inherit; color:var(--heading); }
.tagline { font:18px/1.65 var(--sans); max-width:37ch; margin-bottom:25px; color:var(--text); }
.cta-row { display:flex; flex-wrap:wrap; gap:12px; }
.btn-primary,.btn-ghost { display:inline-flex; padding:13px 18px; border:1px solid var(--mint); border-radius:5px; font:600 14px/1.4 var(--sans); color:var(--mint); background:#140c19d9; }
.btn-primary { background:var(--coral); border-color:var(--coral); color:var(--bg); }
.art-caption { position:absolute; bottom:9px; right:14px; font:10px/1.5 monospace; color:var(--heading); letter-spacing:.08em; text-transform:uppercase; }
.opening-game { border-color:var(--mint); display:flex; align-items:flex-end; }
.development-badge { position:absolute; top:15px; right:15px; background:var(--coral); color:var(--bg); padding:8px 12px; border-radius:5px; font:600 11px/1.4 monospace; text-transform:uppercase; letter-spacing:.04em; }
.game-copy { padding:80px 28px 28px; width:100%; background:linear-gradient(transparent,var(--bg) 40%); }
.game-copy h2 { font:700 36px/1.1 var(--display); color:var(--heading); text-transform:uppercase; letter-spacing:.06em; }
.game-copy p { font:17px/1.6 var(--sans); margin:12px 0 18px; }
.crystal-section { margin:0 3% 25px; padding:18px 20px; border:1px solid var(--line); border-radius:7px; background:var(--panel); }
.crystal-row { display:grid; grid-template-columns:155px repeat(7,minmax(0,1fr)); gap:10px; align-items:center; }
.crystal-label h2 { font:14px/1.5 monospace; text-transform:uppercase; letter-spacing:.13em; color:var(--heading); }
.crystal-label p { font:12px/1.7 monospace; color:var(--muted); margin-top:12px; }
.crystal-item { min-width:0; text-align:center; border-radius:5px; }
.crystal-link { display:flex; flex-direction:column; align-items:center; gap:10px; font:600 12px/1.4 var(--sans); color:var(--heading); padding:8px 3px; }
.crystal-link :global(svg) { transition:transform .18s; }
.crystal-item:hover .crystal-link :global(svg),.crystal-link:focus-visible :global(svg) { transform:translateY(-5px); }
.crystal-details { border:0; border-bottom:1px solid transparent; padding:4px 8px; background:none; color:var(--muted); font:11px/1.4 var(--sans); cursor:pointer; }
.crystal-details[aria-pressed=true] { color:var(--mint); border-color:var(--mint); }
.crystal-info { border-top:1px solid var(--line); margin-top:16px; padding-top:16px; }
.crystal-info-content { display:flex; align-items:center; justify-content:space-between; gap:25px; min-height:80px; }
.crystal-info-content[hidden] { display:none; }
.crystal-info h3 { font:600 19px/1.4 var(--sans); color:var(--heading); margin-bottom:6px; }
.crystal-info p { font:16px/1.6 var(--sans); max-width:85ch; color:var(--text); }
.crystal-info .design-button { flex-shrink:0; min-width:170px; }
.crystal-hint { font:11px/1.5 var(--sans); margin-top:14px; color:var(--muted); }
.tools-section { padding:0 3% 24px; }
.tools-heading { display:flex; align-items:center; justify-content:space-between; gap:18px; margin:25px 0 18px; }
.tools-heading h2 { font:700 30px/1.2 var(--display); color:var(--heading); }
.tools-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
.tool-card { display:block; border:1px solid var(--line); border-radius:6px; overflow:hidden; }
.tool-card :global(.tool-preview) { display:block; width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; }
.tool-copy { padding:22px; }.tool-icon { display:none; }
.tool-name { font:600 23px/1.3 var(--sans); color:var(--heading); margin-bottom:12px; }
.tool-desc { font:16px/1.7 var(--sans); color:var(--text); margin-bottom:16px; }
.tool-link,.all-tools { font:600 15px/1.5 var(--sans); color:var(--mint); }.all-tools { display:inline-block; margin-top:16px; }
.feature-deck { grid-template-columns:repeat(2,minmax(0,1fr)); }
.stats-bar { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin:28px 3% 35px; gap:16px; }
.stat { position:relative; isolation:isolate; overflow:hidden; min-height:210px; border:1px solid var(--line); border-radius:7px; background:var(--panel); display:flex; align-items:flex-end; }
.stat::after { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(180deg,#140c1926,#140c1980 40%,#140c19f5 85%); }
.stat-copy { width:100%; position:relative; padding:24px; text-align:left; }
.stat-num { color:var(--heading); font:700 48px/1.1 var(--display); text-shadow:0 2px 12px #140c19; }
.stat-label { color:var(--text); font:14px/1.5 var(--sans); margin-top:8px; }
.stat :global(.stat-backdrop) { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; opacity:.8; }
.stat-network :global(.stat-backdrop) { object-position:center; transform:scale(1.3); }
.stat-edge :global(.stat-backdrop) { object-position:80% center; opacity:.55; }
.stat-line-art { position:absolute; inset:0; width:100%; height:100%; color:var(--mint); z-index:-2; opacity:.6; }
.infinity-art { color:var(--lavender); opacity:.8; }
.stat-time { background:radial-gradient(ellipse at 75% 25%,#80514466,transparent 75%),var(--panel); }
.stat-crystal-art { position:absolute; inset:0; z-index:-2; display:flex; justify-content:center; align-items:flex-start; gap:0; padding-top:25px; }
.stat-crystal-art span { width:32px; flex-shrink:0; transform:translateY(calc(var(--crystal-position) * var(--crystal-position) * 3px)) rotate(calc(var(--crystal-position) * 7deg)); }
.stat-crystal-art :global(svg) { width:54px; max-width:none; }
@media(max-width:1100px) { .crystal-row { grid-template-columns:repeat(7,minmax(0,1fr)); }.crystal-label { grid-column:1/-1; display:flex; gap:20px; align-items:center; }.crystal-label p { margin:0; }.opening-copy { padding:25px; } }
@media(max-width:800px) { .opening { grid-template-columns:1fr; }.hero-left,.opening-game { min-height:420px; }.opening-copy { min-height:420px; }.opening-game { min-height:350px; }.crystal-row { grid-template-columns:repeat(4,minmax(0,1fr)); }.crystal-info-content { flex-direction:column; align-items:flex-start; gap:15px; }.tools-grid,.feature-deck { grid-template-columns:1fr; }.tools-heading { flex-direction:column; align-items:flex-start; }.stats-bar { grid-template-columns:repeat(2,1fr); } }
@media(max-width:480px) { .crystal-row { grid-template-columns:repeat(2,minmax(0,1fr)); }.crystal-label { display:block; }.crystal-label p { margin-top:6px; }.opening-copy { padding:24px; }.game-copy { padding:70px 24px 24px; } }
.hero-wordmark{display:block;width:100%;max-width:510px;height:auto;margin:0 0 18px;filter:drop-shadow(0 2px 10px #170c27)}.mycelium-title{margin:0 0 14px}.mycelium-title img{display:block;width:100%;max-width:510px;height:auto;filter:drop-shadow(0 0 12px rgba(64,236,216,.3))}</style>

